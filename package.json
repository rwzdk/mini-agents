{
  "name": "mini-agents",
  "version": "0.1.0",
  "description": "零依赖的 TypeScript 多智能体编排库：可读源码的 Agent 循环、工具调用、pipeline / supervisor 编排，注入任意 LLM 客户端（OpenAI 兼容或 Mock）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node examples/demo-mock.js",
    "example:research": "npm run build && node examples/research.js"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "llm",
    "tool-calling",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
